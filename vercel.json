{
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "public",
  "framework": "hugo",
  "build": {
    "env": {
      "HUGO_VERSION": "0.136.1",
      "HUGO_ENVIRONMENT": "production"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/docs",
      "destination": "/docs/",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "/zh/",
      "permanent": false
    },
    {
      "source": "/en",
      "destination": "/en/specification/2025-03-26/",
      "permanent": false
    },
    {
      "source": "/zh",
      "destination": "/zh/specification/2025-03-26/",
      "permanent": false
    }
  ],
  "cleanUrls": true,
  "trailingSlash": true
} 